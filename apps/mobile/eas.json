{
  "cli": {
    "version": ">= 16.3.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "development",
        "EXPO_NO_CAPABILITY_SYNC": "1"
      }
    },
    "production": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "node": "20.18.0",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_NO_CAPABILITY_SYNC": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}